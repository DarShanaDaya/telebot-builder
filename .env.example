# Port the platform server listens on
PORT=4000

# Public base URL used to register Telegram webhooks (required for webhook mode).
# e.g. https://bots.example.com or an ngrok URL for local development.
PUBLIC_BASE_URL=

# Auth + encryption secrets. If omitted, random secrets are generated once and
# persisted in .data/secrets.json
JWT_SECRET=
PLATFORM_SECRET=

# Hours of inactivity before a chat session restarts from the beginning
SESSION_TTL_HOURS=24

# Per-update synchronous execution guard. Must be a finite integer from 1–5000.
MAX_FLOW_STEPS_PER_UPDATE=500

# Experimental nodes are disabled in production. Parallel/Webhook flags may be
# used only for non-production development; Function code remains disabled.
ALLOW_EXPERIMENTAL_PARALLEL_NODES=false
ALLOW_EXPERIMENTAL_WEBHOOK_NODES=false

# ---------------------------------------------------------------------------
# Optional: use Supabase (Postgres) instead of the built-in SQLite database.
# Run server/db/supabase-schema.sql in your Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
