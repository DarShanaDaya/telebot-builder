# Port the platform server listens on
PORT=4000

# Public base URL used to register Telegram webhooks (required for webhook mode).
# e.g. https://bots.example.com or an ngrok URL for local development.
PUBLIC_BASE_URL=

# Optional platform-owned subscription management bot. The bot must be created
# with BotFather and is used for /connect codes and subscription operations.
SUBSCRIPTION_BOT_TOKEN=
SUBSCRIPTION_BOT_USERNAME=

# Optional NOWPayments integration. Keep the IPN secret private.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=

# Comma-separated frontend origins allowed to call a production split API.
# Leave blank for same-origin API access only.
CORS_ORIGINS=

# Auth + encryption secrets. If omitted, random secrets are generated once and
# persisted in .data/secrets.json
JWT_SECRET=
PLATFORM_SECRET=

# Hours of inactivity before a chat session restarts from the beginning
SESSION_TTL_HOURS=24

# Per-update synchronous execution guard. Must be a finite integer from 1–5000.
MAX_FLOW_STEPS_PER_UPDATE=500

# HTTP nodes permit HTTPS public targets only by default. These non-production
# test overrides must never be enabled in production.
ALLOW_PRIVATE_HTTP_TARGETS=false
ALLOW_INSECURE_HTTP_TARGETS=false

# Experimental nodes are disabled in production. Parallel/Webhook flags may be
# used only for non-production development; Function code remains disabled.
ALLOW_EXPERIMENTAL_PARALLEL_NODES=false
ALLOW_EXPERIMENTAL_WEBHOOK_NODES=false

# ---------------------------------------------------------------------------
# Optional: use Supabase (Postgres) instead of the built-in SQLite database.
# Run server/db/supabase-schema.sql in your Supabase SQL editor first.
SUPABASE_URL=
# Prefer the new Supabase secret key name. Never expose this to the browser.
SUPABASE_SECRET_KEY=
# Backward-compatible legacy name:
SUPABASE_SERVICE_ROLE_KEY=
